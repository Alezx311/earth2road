config_version=5

[application]
config/name="TerraDrive"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=1
environment/ssao/half_size=true
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.52, 0.68, 0.76, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
; A full build of Західний Київ needs ~21 000 static bodies (441 tiles, one body per
; 250 m chunk and surface kind) plus traffic. The Jolt default of 10 240 silently
; dropped the last ones, leaving roads without collision: that was the 264 "missing
; surface" hits in tools/check_surface.sh and the stuck car in tools/check_drive.sh.
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_contact_constraints=40960
; With that many bodies Jolt outgrew its 32 MiB scratch buffer and fell back to the
; slow general-purpose allocator during the headless full-map checks.
jolt_physics_3d/limits/temporary_memory_buffer_size=128
